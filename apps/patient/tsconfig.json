{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@xolt/shared": [
        "../../packages/shared/src"
      ],
      "@xolt/ui": [
        "../../packages/ui/src"
      ],
      "@xolt/ui-tokens": [
        "../../packages/ui-tokens/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
