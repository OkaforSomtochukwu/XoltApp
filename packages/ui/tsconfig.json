{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@xolt/shared": ["../shared/src"],
      "@xolt/ui-tokens": ["../ui-tokens/src"]
    }
  },
  "include": ["src"]
}
